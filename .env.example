# Next.js uses NEXT_PUBLIC_ names, not VITE_. setup.mjs generates .env.local correctly.
NEXT_PUBLIC_DATA_MODE=api
NEXT_PUBLIC_RELEASE_PHASE=2
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PROJECT_KEY
NEXT_PUBLIC_ENABLE_INDEXING=false
NEXT_PUBLIC_IMAGE_HOSTS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_HOURS=
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional server-only routing behind a reverse proxy:
# API_INTERNAL_URL=http://api:4000/api/v1
# Never put a database password, service-role key or ORDER_ACCESS_SECRET in this file.
